# Main address people type in the browser (scheme + host + port). Used for e-mail links.
BETTER_AUTH_URL=http://localhost:5188
# 32+ random characters. `npm run setup` (local) or `node scripts/docker-env.mjs` (Docker) generate one for you.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OIMO_DATA_DIR=./data
# 127.0.0.1 = only this computer. 0.0.0.0 = phones on the Wi-Fi too (`npm run lan` sets this up).
OIMO_HOST=127.0.0.1
# Extra exact origins allowed to send requests, comma-separated (localhost/127.0.0.1 on the same port are always allowed).
OIMO_TRUSTED_ORIGINS=
# true = also trust this computer's own private LAN IPs and <name>.local (re-read automatically when the IP changes).
# Turned on automatically when OIMO_HOST=0.0.0.0.
OIMO_TRUST_LAN=false
# TEST ONLY, never with real data: accept any local-network host/IP whose Origin matches it. Login and roles stay enforced.
OIMO_OPEN_TEST_ACCESS=false
# Optional fixed address for invitation links created while the owner is on localhost (e.g. http://192.168.1.100:5188).
OIMO_SHARE_URL=
# true = only the first store may be created on this server; later accounts can only join by invitation.
OIMO_SINGLE_STORE=false
# Only behind your own reverse proxy: its IP/CIDR list, comma-separated (e.g. 172.16.0.0/12). Leave empty otherwise.
TRUSTED_PROXIES=
# Optional. Enables password-reset and email-verification letters. Without it, use `npm run admin:reset-password`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
